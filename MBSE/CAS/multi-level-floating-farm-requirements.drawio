        <mxCell id="MFF-07" value="MFF-07 · Impacto medible · P1&lt;br&gt;Evaluar consumo, residuos y observaciones ambientales con línea base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
