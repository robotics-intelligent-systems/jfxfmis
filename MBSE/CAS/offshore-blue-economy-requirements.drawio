  <diagram id="page-2" name="02 · OBE · Requisitos y aceptación">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02 · OBE · Requisitos y aceptación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Requisitos propuestos · Pendientes de validación · P1: necesarios para validar el concepto. Umbrales y parámetros TBD se fijan antes del ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="OBE-01" value="OBE-01 · Identidad y topología · P1&lt;br&gt;Registrar plataforma, jaulas, longlines, buques y amarres como activos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-01" value="Verificación: Inspección + prueba · Responsable: Arquitectura&lt;br&gt;Aceptación: Cada activo y relación identificados en geometría versionada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-02" value="OBE-02 · Respuesta hidrodinámica · P1&lt;br&gt;Definir casos de flujo, oleaje y movimiento de plataforma." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-02" value="Verificación: Análisis CFD cualificado · Responsable: Hidrodinámica&lt;br&gt;Aceptación: Malla, fronteras y convergencia verificadas; límites TBD explícitos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-03" value="OBE-03 · Degradación de amarre · P1&lt;br&gt;Evaluar variaciones de propiedades, redistribución de carga y excursión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-03" value="Verificación: Análisis especializado · Responsable: Ingeniería naval&lt;br&gt;Aceptación: Modelo estructural/amarre verificado; límites TBD revisados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="400" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-04" value="OBE-04 · Acuicultura offshore · P1&lt;br&gt;Relacionar peces/mejillones, calidad de agua y supuestos biológicos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-04" value="Verificación: Análisis + ensayo · Responsable: Acuicultura&lt;br&gt;Aceptación: Indicadores por especie y sitio sustentados; CFD no prueba salud." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="500" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-05" value="OBE-05 · Corte de energía · P1&lt;br&gt;Evaluar demanda no servida, almacenamiento y cargas esenciales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-05" value="Verificación: Simulación + ensayo · Responsable: Energía&lt;br&gt;Aceptación: Recuperación y continuidad según umbrales TBD aceptados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="600" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-06" value="OBE-06 · Corredor de servicio · P1&lt;br&gt;Representar accesos de apoyo, alimentación, cosecha y mantenimiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-06" value="Verificación: Revisión + demostración · Responsable: Operaciones&lt;br&gt;Aceptación: Interferencias e interfaces documentadas; operación TBD revisada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="OBE-07" value="OBE-07 · Interfaz aeroportuaria · P1&lt;br&gt;Registrar terminal, pista y drone port como estudio de concepto separado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-OBE-07" value="Verificación: Revisión de alcance · Responsable: Especialista designado&lt;br&gt;Aceptación: Geometría, cargas y restricciones a definir; sin certificación aeronáutica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="800" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="Trazabilidad: fuente CAD/README → requisito → interfaz/modelo → caso de prueba → evidencia → revisión.&lt;br&gt;Cada evidencia incluye versión, entradas, unidades, resultados, incertidumbre y estado de validación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1520" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
