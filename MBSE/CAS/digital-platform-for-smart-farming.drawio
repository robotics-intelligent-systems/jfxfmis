  <diagram id="page-2" name="02 · Requisitos transversales">
    <mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02 · Requisitos transversales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Requisitos propuestos · Pendientes de validación · P1: necesarios para validar el concepto. Umbrales y parámetros TBD se fijan antes del ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="COM-01" value="COM-01 · Contrato de observaciones · P1&lt;br&gt;Conservar activo, variable, valor, unidad, tiempos, calidad, calibración y versión." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-01" value="Verificación: Prueba de contrato · Responsable: Datos / IoT&lt;br&gt;Aceptación: Valores ausentes/obsoletos explícitos; conversión de unidades comprobada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-02" value="COM-02 · Historia y escenarios · P1&lt;br&gt;Separar estado medido, estimado, pronosticado y simulado, con procedencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-02" value="Verificación: Prueba de integración · Responsable: Gemelo digital&lt;br&gt;Aceptación: Un escenario no sobrescribe observaciones; revisiones reconstruibles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-03" value="COM-03 · Simulación reproducible · P1&lt;br&gt;Archivar geometría, parámetros, hashes, versiones, fronteras y resultados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-03" value="Verificación: Análisis + inspección · Responsable: Simulación&lt;br&gt;Aceptación: Casos repetibles y revisados; errores e incertidumbre registrados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="400" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-04" value="COM-04 · Acciones controladas · P1&lt;br&gt;Separar recomendación, aprobación, envío, acuse, ejecución y resultado observado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-04" value="Verificación: Prueba de fallos · Responsable: Control / operaciones&lt;br&gt;Aceptación: Rechazar caducadas/duplicadas; parada local preservada sin nube." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="500" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-05" value="COM-05 · Interoperabilidad · P1&lt;br&gt;Versionar contratos y adaptadores; ensayar pérdida de enlace y replay offline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-05" value="Verificación: Prueba de integración · Responsable: Integraciones&lt;br&gt;Aceptación: Replay idempotente y sin pérdida de historia; errores conciliados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="600" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-06" value="COM-06 · Acceso y auditoría · P1&lt;br&gt;Aplicar permisos por sitio/activo y auditar lecturas, cambios y acciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-06" value="Verificación: Prueba positiva/negativa · Responsable: Seguridad TI&lt;br&gt;Aceptación: Accesos no autorizados rechazados; actor y revisión registrados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="COM-07" value="COM-07 · Cierre de requisitos · P1&lt;br&gt;Ligar fuente, requisito, modelo, prueba, evidencia y aprobación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-COM-07" value="Verificación: Inspección documental · Responsable: Requisitos / QA&lt;br&gt;Aceptación: Todo requisito en alcance tiene evidencia o excepción aprobada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="800" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="Trazabilidad: fuente CAD/README → requisito → interfaz/modelo → caso de prueba → evidencia → revisión.&lt;br&gt;Cada evidencia incluye versión, entradas, unidades, resultados, incertidumbre y estado de validación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1520" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
