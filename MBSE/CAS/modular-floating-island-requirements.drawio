        </mxCell>
        <mxCell id="note" value="Requisitos propuestos · Pendientes de validación · P1: necesarios para validar el concepto. Umbrales y parámetros TBD se fijan antes del ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="MFI-01" value="MFI-01 · Configuración modular · P1&lt;br&gt;Identificar módulos, conexiones, revisiones y recursos compartidos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-01" value="Verificación: Inspección + prueba · Responsable: Arquitectura naval&lt;br&gt;Aceptación: Topología y cambios trazables; cada interfaz tiene contrato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-02" value="MFI-02 · Estabilidad y oleaje · P1&lt;br&gt;Definir cargas, flotación y respuesta de distintas configuraciones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-02" value="Verificación: Análisis especializado · Responsable: Ingeniería naval&lt;br&gt;Aceptación: Casos de oleaje y envolventes TBD revisados con evidencia numérica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-03" value="MFI-03 · Uniones estructurales · P1&lt;br&gt;Modelar transferencia de carga y movimiento relativo en conexiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-03" value="Verificación: Análisis + ensayo · Responsable: Estructuras&lt;br&gt;Aceptación: Límites de esfuerzo, fatiga y desplazamiento TBD verificados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="400" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-04" value="MFI-04 · Materiales marinos · P1&lt;br&gt;Comparar GFRP, refuerzo CFRP, núcleo y recubrimientos como candidatos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-04" value="Verificación: Ensayo + revisión · Responsable: Materiales&lt;br&gt;Aceptación: Propiedades, exposición, durabilidad y ciclo de vida documentados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="500" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-05" value="MFI-05 · Agua y nutrientes · P1&lt;br&gt;Representar tratamiento, irrigación, retorno y recuperación de nutrientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-05" value="Verificación: Análisis + ensayo · Responsable: Agua / procesos&lt;br&gt;Aceptación: Balances y calidad de agua según tolerancias TBD; pérdidas registradas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="600" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-06" value="MFI-06 · Energía compartida · P1&lt;br&gt;Relacionar solar, demanda y distribución entre módulos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-06" value="Verificación: Simulación + ensayo · Responsable: Energía&lt;br&gt;Aceptación: Escenario de desconexión no propaga fallos fuera de límites TBD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MFI-07" value="MFI-07 · Reconfiguración mantenible · P1&lt;br&gt;Definir aislamiento de recursos y sustitución de módulos/conexiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="740" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v-MFI-07" value="Verificación: Revisión + demostración · Responsable: Operaciones&lt;br&gt;Aceptación: Secuencia de mantenimiento y continuidad aprobadas en ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="810" y="800" width="750" height="90" as="geometry" />
        </mxCell>
        <mxCell id="trace" value="Trazabilidad: fuente CAD/README → requisito → interfaz/modelo → caso de prueba → evidencia → revisión.&lt;br&gt;Cada evidencia incluye versión, entradas, unidades, resultados, incertidumbre y estado de validación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1520" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
